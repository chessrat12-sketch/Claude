# Copy this file to ".env" (same folder) and fill in ONE provider below.
# .env is gitignored -- your key never gets committed or pushed.
# Once .env exists, `py -m server.viz_server --llm ...` picks it up
# automatically -- no more retyping `set`/`export` every session.

# --- Groq (free tier, no card required) — console.groq.com ---
# Free-tier token-per-minute limits are tight (e.g. 6000 TPM on this model).
# The server's default --llm-gap-ms 8000 already paces calls to stay under
# that, regardless of --agents count — no extra flags needed.
EC_LLM_BASE_URL=https://api.groq.com/openai/v1
EC_LLM_MODEL=llama-3.1-8b-instant
EC_LLM_API_KEY=gsk_your_real_key_here

# --- OpenRouter (":free"-tagged models, no card required) — openrouter.ai ---
# EC_LLM_BASE_URL=https://openrouter.ai/api/v1
# EC_LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# EC_LLM_API_KEY=sk-or-your_real_key_here

# --- NVIDIA API Catalog (free tier) — build.nvidia.com ---
# EC_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# EC_LLM_MODEL=meta/llama-3.1-8b-instruct
# EC_LLM_API_KEY=nvapi-your_real_key_here

# --- Google Gemini (OpenAI-compatible endpoint) — aistudio.google.com/apikey ---
# EC_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EC_LLM_MODEL=gemini-2.0-flash
# EC_LLM_API_KEY=AIza_your_real_key_here

# --- xAI Grok — console.x.ai (needs billing/credits) ---
# EC_LLM_BASE_URL=https://api.x.ai/v1
# EC_LLM_MODEL=grok-2-latest
# EC_LLM_API_KEY=xai-your_real_key_here

# --- Fully local (Ollama) — no cloud, no real key needed ---
# No rate limit (just your CPU/GPU speed), so also pass --llm-gap-ms 0.
# EC_LLM_BASE_URL=http://localhost:11434/v1
# EC_LLM_MODEL=llama3.2
# EC_LLM_API_KEY=ollama

# --- Anthropic ---
# EC_LLM_API_KEY=sk-ant-your_real_key_here
# EC_LLM_MODEL=claude-haiku-4-5-20251001
